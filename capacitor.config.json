{
  "appId": "vn.ecoimpact.app",
  "appName": "EcoImpact",
  "webDir": "dist",
  "backgroundColor": "#07533f",
  "android": {
    "backgroundColor": "#07533f",
    "allowMixedContent": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1500,
